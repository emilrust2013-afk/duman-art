rules_version = '2';

// Duman Art — правила Firestore.
// Заказы создаются и меняются только сервером (Firebase Admin SDK обходит
// эти правила). Администратор — пользователь с custom claim admin: true
// (scripts/set-admin-claims.mjs).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Каталог: читать всем, менять — только админам.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Настройки магазина (номер карты для оплаты): читать всем, менять — админам.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Профиль клиента (имя, телефон, адреса): владелец; админы — только чтение.
    // Документ создаёт сервер при первом заказе (/api/orders/create),
    // до этого профиль хранится у клиента в localStorage. Клиент может
    // только обновлять уже созданный профиль.
    match /users/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn()
        && request.auth.uid == userId;
    }

    // Заказы: читать — владелец или админ. Создание и изменение с клиента
    // запрещены (только через серверные маршруты). Удалять может админ.
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Всё остальное (включая неиспользуемую коллекцию collections) запрещено.
  }
}
