# Telegram-бот (bot/index.js). Можно положить в bot/.env или в корневой .env.
# На хостинге задайте эти переменные в настройках окружения.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Числовые Telegram ID администраторов через запятую (узнать: команда /myid)
TELEGRAM_ADMIN_CHAT_IDS=

# HTTPS-адрес Mini App (Next.js), без слеша в конце
DUMAN_ART_STORE_URL=
